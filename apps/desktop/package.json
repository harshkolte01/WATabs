{
  "name": "@multi-whatsapp/desktop",
  "version": "0.0.0",
  "private": true,
  "description": "Desktop app: multi-account WhatsApp Web workspace (Electron)",
  "main": ".vite/build/index.js",
  "scripts": {
    "prestart": "node ../../scripts/ensure-electron-link.cjs",
    "prepackage": "node ../../scripts/ensure-electron-link.cjs",
    "start": "node ../../node_modules/@electron-forge/cli/dist/electron-forge.js start",
    "package": "node ../../node_modules/@electron-forge/cli/dist/electron-forge.js package",
    "make": "node ../../node_modules/@electron-forge/cli/dist/electron-forge.js make",
    "build": "pnpm run package",
    "typecheck": "node ../../node_modules/typescript/bin/tsc -p tsconfig.json --noEmit",
    "lint": "echo \"lint deferred to eslint-config expansion\"",
    "test": "pnpm run test:unit",
    "test:unit": "node ../../node_modules/vitest/vitest.mjs run --config vitest.config.ts",
    "verify:fuses": "tsx ../../scripts/verify-fuses.ts"
  },
  "dependencies": {
    "@multi-whatsapp/shared-types": "workspace:*",
    "@multi-whatsapp/validation": "workspace:*",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.9.0",
    "@electron-forge/maker-squirrel": "7.9.0",
    "@electron-forge/maker-zip": "7.9.0",
    "@electron-forge/plugin-fuses": "7.9.0",
    "@electron-forge/plugin-vite": "7.9.0",
    "@electron/fuses": "1.8.0",
    "@types/node": "24.3.0",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.2",
    "electron": "43.2.0",
    "typescript": "5.9.2",
    "vite": "7.1.5",
    "vitest": "3.2.4"
  }
}
